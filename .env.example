# Shared server-side configuration. Set real values in Vercel Project Settings.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_DB=travelexpertz

# Authentication. Use unique, high-entropy secrets in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-admin-password
INIT_TOKEN=replace-with-a-long-random-token

# Email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password

# Public, non-secret values
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Local Express development only; Vercel supplies PORT.
PORT=5000
