{
  "services": {
    "backend": {
      "root": "backend",
      "entrypoint": "src/server.js",
      "routes": [
        {
          "src": "/api/backend/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/api/$1"
            }
          ]
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/backend/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    }
  ]
}